# ============================================
# CivicLens — environment template
# Copy to .env and fill with REAL values.
# .env is gitignored. NEVER commit real values here.
# ============================================

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT reuse this placeholder. Do NOT ship a default in code.
SECRET_KEY=replace_me_with_generated_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Dev/demo default (SQLite). For Postgres:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/civiclens
DATABASE_URL=sqlite:///./civiclens.db

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- CORS ---
# Comma-separated. NEVER use "*" together with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI ---
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
AI_ENABLED=true
DUP_SIMILARITY_THRESHOLD=0.86
DUP_RADIUS_METERS=100
DUP_TIME_WINDOW_DAYS=30

# --- App ---
DEBUG=false
ENVIRONMENT=development


# ============================================
# FRONTEND — put these in frontend/.env
# WARNING: every VITE_* value is compiled into the
# PUBLIC browser bundle. Public values ONLY.
# Never put SECRET_KEY, DATABASE_URL, or any API
# key here.
# ============================================
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
